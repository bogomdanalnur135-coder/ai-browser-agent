# API key for OpenAI. Do not commit or share this file.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1

# Generate a long random secret, e.g. openssl rand -hex 32
API_TOKEN=replace-with-a-random-secret-at-least-24-characters
PORT=8080
HEADLESS=true

# Performance / memory settings
MAX_STEPS=30
PAGE_TEXT_LIMIT=10000
MEMORY_FILE=data/memory.json
