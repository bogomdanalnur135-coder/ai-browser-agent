# Amazon Bedrock (Converse API). Do not commit or share this file.
AWS_BEARER_TOKEN_BEDROCK=replace-with-bedrock-api-key
AWS_BEDROCK_MODEL_ID=replace-with-model-or-inference-profile-id
AWS_BEDROCK_REGION=us-east-1
# Optional: override endpoint (default: https://bedrock-runtime.<region>.amazonaws.com)
# AWS_BEDROCK_ENDPOINT=

# Generate a long random secret, e.g. openssl rand -hex 32
API_TOKEN=replace-with-a-random-secret-at-least-24-characters
PORT=8080
HEADLESS=true

# Agent limits
MAX_STEPS=30
PAGE_TEXT_LIMIT=10000
MEMORY_FILE=data/memory.json
# WORKFLOWS_FILE=data/workflows.json

# Workflow replay
STEP_TIMEOUT_MS=15000        # how long a replayed step waits for its element (SPA / slow pages)
APPROVAL_TIMEOUT_MS=900000   # auto-reject a pending confirmation after 15 min so the queue never hangs
TASK_TTL_MS=3600000          # keep finished tasks in RAM for 1 h
MAX_TASKS=200

# Container resources (docker compose)
AGENT_MEM_LIMIT=4g
AGENT_SHM_SIZE=2gb
